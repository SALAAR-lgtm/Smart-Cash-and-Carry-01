# Copy to .env and fill in. Never commit .env — it is in .gitignore.
# No real secrets belong in THIS file, only names and safe defaults.

# --- Local dev on Qasim's PC -------------------------------------------------
# pglite   real Postgres as WebAssembly inside Node. No Docker, no install.
# postgres the real driver, used inside Docker on the VM.
DB_DRIVER=pglite
PGLITE_DIR=./.pgdata

# --- Used when DB_DRIVER=postgres (Docker Compose / VM) ----------------------
# "db" is the compose service name; the backend reaches it over the Docker network.
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=scc
POSTGRES_USER=scc
POSTGRES_PASSWORD=change-me

# --- Ports -------------------------------------------------------------------
BACKEND_PORT=4000
# 8083 is the only frontend port open in the OCI Security List on the old VM.
FRONTEND_PORT=8083
